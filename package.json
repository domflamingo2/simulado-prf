{
  "name": "simulado-prf",
  "version": "2.0.0",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "analyze": "ANALYZE=true next build",
    "bundle": "npm run build && npm run bundle-analyze",
    "python:scrape": "python scripts/scraper_questoes.py",
    "python:analyze": "python scripts/analise_banco.py",
    "python:validate": "python scripts/validador_banco.py",
    "python:export": "python scripts/exportador.py",
    "python:maintain": "python scripts/manutencao.py",
    "python:api": "uvicorn api.index:app --reload"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.0.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.29.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.3.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
